# 本文件是编辑器的行为约定，也是 `dotnet format` 的输入。
# 目标：把 docs/07 §7.2 记录的「人肉纪律」变成机器强制（缺口 G6）。
#
# ⚠️ end_of_line 必须是 lf：
#    .gitattributes 的 `* text=auto eol=lf` 要求仓库内一律 LF，
#    CI 的 hygiene 作业会拒绝 w/crlf。
#    而 `dotnet format` 在本文件缺失时的**默认行尾是 CRLF** ——
#    少了这一行，格式化会把仓库改成 CRLF 并让 CI 变红。
#
# 为什么只做 whitespace、不开 analyzer：
#   实测 `dotnet format --severity info` 在本仓库报 21 条 analyzer 建议
#   （CA2016 / CA1873 / CA1816 / CA1861 / SYSLIB1045 / ASP0025）。
#    一次性把它们变成门禁 = 21 处改动 + 长期噪音，属于过度工程化。
#    见 plan/2026-09-14-大整理与上线方案.md §4。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md,ts,vue,js,mjs,css,html,scss}]
indent_size = 2

[*.md]
# Markdown 里行尾两个空格是有意义的硬换行，trim 会破坏排版
trim_trailing_whitespace = false

[*.cs]
# 与本项目既有风格一致：文件级命名空间 + Allman 大括号 + 继承冒号前有空格
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_space_before_colon_in_inheritance_clause = true
indent_size = 4
