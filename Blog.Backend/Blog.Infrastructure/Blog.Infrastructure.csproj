<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Infrastructure 需要访问 HttpContext（实现 ICurrentUser 与解析中间件），
         因此引入 ASP.NET Core 共享框架引用（不产生额外运行时依赖，宿主已自带）。 -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <!--
      这里**刻意不写**下面这些包：
        Microsoft.Extensions.Caching.Memory / Configuration.Abstractions / Configuration.Binder
        Microsoft.Extensions.Options / Options.ConfigurationExtensions
        Microsoft.Extensions.DependencyInjection.Abstractions / Logging.Abstractions

      它们由上面的 <FrameworkReference Include="Microsoft.AspNetCore.App" /> 提供
      （.NET 10 的包裁剪会把显式引用判为冗余，报 NU1510，构建不再是 0 警告）。
      需要用到这些命名空间时直接 using 即可，**不要重新加回 PackageReference**。
    -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- 上传图片转 WebP（见 Files/ImageOptimization）。**刻意固定在 3.x**：
         v4 起要求构建期许可密钥 sixlabors.lic，社区许可虽免费但需先申请，否则构建直接报错。
         v3 为纯托管实现（无原生依赖），部署最简。
         许可：Six Labors Split License —— 开源或年营收 < 100 万美元视同 Apache-2.0。 -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="StackExchange.Redis" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blog.Application\Blog.Application.csproj" />
  </ItemGroup>

</Project>
