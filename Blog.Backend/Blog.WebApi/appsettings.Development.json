{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=blog_stage2;Username=kky;Password=123456;"
  },
  "Cache": {
    "Enabled": true,
    "Provider": "Redis", //"Redis", "Memory"
    "RedisConnection": "localhost:6379",
    "NullTtl": "00:02:00",
    "LockWaitTimeout": "00:00:03",
    "TtlJitterRatio": 0.2
  },
  "FileStorage": {
    "Root": "media",
    // 只读种子资源目录（默认头像等随仓库分发的文件）。读取时作为 Root 未命中后的回退，
    // 不参与上传写入。由 csproj 把 media-seed/ 复制到输出目录（见 Blog.WebApi.csproj）。
    "SeedRoot": "media-seed",
    "MaxFileSize": 10485760,
    // 上传的位图自动转 WebP 以节省传输流量。失败/不该转的情况一律原样保存。
    "ImageOptimization": {
      "Enabled": true,
      "WebpQuality": 82,
      "MaxDimension": 2560,
      "MaxPixels": 40000000,
      "ConvertExtensions": [ ".png", ".jpg", ".jpeg" ]
    }
  },
  "RateLimit": {
    "Enabled": true,
    "FallbackToMemory": true,
    "Rules": [
      {
        "Name": "search",
        "PathPrefix": "/api/posts/search",
        "Method": "GET",
        "Granularity": "Ip",
        "Capacity": 20,
        "TokensPerSecond": 2
      },
      {
        "Name": "write",
        "PathPrefix": "/api",
        "Method": "POST",
        "Granularity": "Ip",
        "Capacity": 30,
        "TokensPerSecond": 2
      },
      {
        "Name": "default",
        "PathPrefix": "/api",
        "Method": "",
        "Granularity": "Ip",
        "Capacity": 120,
        "TokensPerSecond": 20
      }
    ]
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "Jwt": {
    "Issuer": "blog-api",
    "Audience": "blog-frontend",
    "AccessTokenMinutes": 30,
    "//SigningKey": "仅开发用的固定密钥。生产环境 appsettings.json 中**不含**本键，因此生产必须通过环境变量 Jwt__SigningKey 或 user-secrets 注入，否则应用拒绝启动。生成示例：openssl rand -base64 48",
    "SigningKey": "dev-only-insecure-signing-key-do-not-use-in-production-0123456789"
  },
  "Deployment": {
    "InstanceCount": 1,
    "RequireRedis": false,
    "_comment": "InstanceCount > 1 或 RequireRedis = true 时，必须同时配置 Cache:Provider = Redis，否则应用启动即失败（见 docs/02-架构与数据模型.md §16 / T5）"
  }
}
