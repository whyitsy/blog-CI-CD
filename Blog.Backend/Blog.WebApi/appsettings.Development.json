{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=blog_stage2;Username=kky;Password=123456;"
  },
  "Cache": {
    "Enabled": true,
    "Provider": "Redis", //"Redis", "Memory"
    "RedisConnection": "localhost:6379",
    "NullTtl": "00:02:00",
    "LockWaitTimeout": "00:00:03",
    "TtlJitterRatio": 0.2
  },
  "FileStorage": {
    "Root": "media",
    "MaxFileSize": 10485760
  },
  "RateLimit": {
    "Enabled": true,
    "FallbackToMemory": true,
    "Rules": [
      {
        "Name": "search",
        "PathPrefix": "/api/posts/search",
        "Method": "GET",
        "Granularity": "Ip",
        "Capacity": 20,
        "TokensPerSecond": 2
      },
      {
        "Name": "write",
        "PathPrefix": "/api",
        "Method": "POST",
        "Granularity": "Ip",
        "Capacity": 30,
        "TokensPerSecond": 2
      },
      {
        "Name": "default",
        "PathPrefix": "/api",
        "Method": "",
        "Granularity": "Ip",
        "Capacity": 120,
        "TokensPerSecond": 20
      }
    ]
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  }
}
